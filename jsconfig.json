{
    "compilerOptions": {
        "baseUrl": ".",
        "target": "ES2020",
        "lib": ["ES2020", "DOM", "DOM.Iterable"],
        "checkJs": false,
        "module": "ESNext",
        "moduleResolution": "Node",
        "jsx": "react-jsx",
        "allowSyntheticDefaultImports": true,
        "paths": {
            "*": ["src/*"]
        }
    },
    "include": [
        "src",
        "vite.config.js"
    ],
    "exclude": [
        "node_modules",
        "**/node_modules/*"
    ]
}
